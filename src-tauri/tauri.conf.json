{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vulgar Notes",
  "version": "0.1.40",
  "identifier": "net.zhaiyusci.math-editor",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vulgar Notes",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 540,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost data: blob: https:; worker-src 'self' blob:; frame-src https:"
    }
  },
  "bundle": {
    "active": true,
    "fileAssociations": [
      {
        "ext": ["vulgar"],
        "name": "VulgarNotes.Document",
        "description": "Vulgar Notes document",
        "role": "Editor",
        "mimeType": "application/x-vulgar-notes"
      }
    ],
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
