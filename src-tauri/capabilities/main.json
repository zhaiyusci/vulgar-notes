{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Open and save documents only at paths selected through native dialogs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "fs:allow-read-text-file"
  ]
}
