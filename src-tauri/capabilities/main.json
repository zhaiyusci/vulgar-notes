{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Create local document windows and open or save documents only at exact paths selected through native dialogs or system file-open requests.",
  "windows": [
    "main",
    "document-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:webview:allow-create-webview-window",
    "dialog:allow-save",
    "fs:allow-write-file",
    "dialog:allow-open",
    "dialog:allow-confirm",
    "fs:allow-read-text-file"
  ]
}
